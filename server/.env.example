# ── Базовое ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Домен сайта для CORS в проде (в деве не требуется).
# CORS_ORIGIN=https://pomogarium.ru

# ── Telegram-бот для заявок ───────────────────────────────
# Новые заявки бот рассылает ВСЕМ, кто отправил ему /start.
# Токен бота: @BotFather → /newbot (или /token для существующего).
TELEGRAM_BOT_TOKEN=

# Необязательный код-пароль для подписки. Если задан — получать заявки
# сможет только тот, кто напишет боту "/start ЭТОТ_КОД".
# Пусто = подписаться может любой, кто найдёт бота.
TELEGRAM_SUBSCRIBE_CODE=

# Заявки всегда дублируются в server/data/leads.csv (резервная копия).
